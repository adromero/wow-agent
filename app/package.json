{
  "name": "wow-agent",
  "version": "1.0.0",
  "description": "AI Assistant for World of Warcraft Classic",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc",
    "build:renderer": "rm -rf dist/renderer && cp -r src/renderer dist/renderer",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.52.0",
    "@mariozechner/pi-ai": "^0.52.0",
    "dotenv": "^17.2.4",
    "luaparse": "^0.3.1"
  },
  "devDependencies": {
    "@types/luaparse": "^0.2.13",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.7.0"
  }
}
